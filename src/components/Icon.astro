---
interface Props {
  name:
    | 'arrow'
    | 'chevron'
    | 'menu'
    | 'close'
    | 'alert'
    | 'bus'
    | 'car'
    | 'pin'
    | 'clock'
    | 'mountain'
    | 'food'
    | 'route'
    | 'external'
    | 'info'
    | 'snow'
    | 'rain'
    | 'check';
  size?: number;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 20, class: className = '', strokeWidth = 1.7 } = Astro.props;

const icons: Record<Props['name'], string[]> = {
  arrow: ['M5 12h14', 'm13 6 6 6-6 6'],
  chevron: ['m9 18 6-6-6-6'],
  menu: ['M4 7h16', 'M4 12h16', 'M4 17h16'],
  close: ['M6 6l12 12', 'M18 6 6 18'],
  alert: ['M12 3 2.8 19h18.4L12 3Z', 'M12 9v4', 'M12 17h.01'],
  bus: ['M6 17h12', 'M7 17v2', 'M17 17v2', 'M5 6c0-2 1.5-3 3.5-3h7C17.5 3 19 4 19 6v9H5V6Z', 'M5 9h14', 'M8 12h.01', 'M16 12h.01'],
  car: ['M5 17h14', 'M6 17v2', 'M18 17v2', 'm4 13 2-5h12l2 5', 'M3 13h18v4H3v-4Z', 'M7 15h.01', 'M17 15h.01'],
  pin: ['M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z', 'M12 10a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Z'],
  clock: ['M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z', 'M12 7v5l3 2'],
  mountain: ['m3 19 6-11 4 6 2-3 6 8H3Z', 'm9 8 2 3 2-2'],
  food: ['M7 3v8', 'M4 3v5c0 2 1.3 3 3 3s3-1 3-3V3', 'M7 11v10', 'M16 3c2 0 3 2 3 5v5h-4V8c0-3 0-5 1-5Z', 'M17 13v8'],
  route: ['M5 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z', 'M19 5a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z', 'M7 17c4 0 2-8 6-8h4'],
  external: ['M14 4h6v6', 'M20 4 11 13', 'M19 13v6H5V5h6'],
  info: ['M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18Z', 'M12 11v6', 'M12 7h.01'],
  snow: ['M12 2v20', 'm4.2 6 15.6 12', 'm19.8 6-15.6 12', 'm9 4 3 2 3-2', 'm9 20 3-2 3 2'],
  rain: ['M16 13a4 4 0 0 0-7.8-1A3.5 3.5 0 1 0 7 18h9a2.5 2.5 0 0 0 0-5Z', 'm8 20-1 2', 'm13 20-1 2', 'm18 20-1 2'],
  check: ['m5 12 4 4L19 6'],
};
---
<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {icons[name].map((d) => <path d={d} />)}
</svg>
