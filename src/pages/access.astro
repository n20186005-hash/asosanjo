---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import RouteDiagram from '../components/RouteDiagram.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config/site';

const MAP_EMBED_URL = 'https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d3350.6897346522032!2d131.07399!3d32.8799276!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3540d8f343ab97f7%3A0xa7d0eb6e3ec8ba2d!2sAso%20Sanjo%20Public%20Square!5e0!3m2!1sja!2sJP!4v1785405959886!5m2!1sja!2sJP';
---
<BaseLayout title="アクセス｜阿蘇駅からのバス・車・駐車場" description="阿蘇山上広場へのアクセスを、阿蘇駅からの路線バス、自家用車、草千里からの移動に分けて案内します。">
  <PageHero eyebrow="ACCESS" title="山上への行き方" description="便数の限られた路線バスと、天候に左右される山道。行き方だけでなく、帰り方まで決めてから出発しましょう。" image="/images/kusasenri-dry.webp" imageAlt="春先の草千里と阿蘇山の山並み" />

  <section class="py-16 md:py-24">
    <div class="site-container">
      <SectionHeading eyebrow="PUBLIC TRANSPORT" title="阿蘇駅から、路線バスで。" description="公共交通なら、JR阿蘇駅前から阿蘇登山線で阿蘇山上ターミナルへ向かいます。所要は約35分が目安です。予約不要の通常路線ですが、便数は多くありません。" />
      <div class="mt-10 grid gap-px bg-ink/15 md:grid-cols-4">
        {[
          ['乗車', '阿蘇駅前', '駅を出てバス乗り場へ'],
          ['路線', '阿蘇登山線', '草千里経由・山上方面'],
          ['目安', '約35分', '混雑や道路で変動'],
          ['大切', '復路を先に確認', '最終便を見落とさない'],
        ].map(([label, value, note]) => (
          <div class="bg-paper p-6">
            <p class="text-[0.68rem] font-bold tracking-[0.14em] text-moss">{label}</p>
            <p class="mt-4 font-serif text-xl">{value}</p>
            <p class="mt-2 text-xs leading-6 text-ink-soft">{note}</p>
          </div>
        ))}
      </div>
      <div class="mt-7 border-l-2 border-sulfur pl-5 text-sm leading-8 text-ink-soft">
        <p>山上のバス車内にはトイレがありません。天候や道路状況で運休・区間変更となる場合があるため、当日の運行案内を確認してください。</p>
      </div>
    </div>
  </section>

  <section class="border-y hairline bg-paper-deep/55 py-16 md:py-24">
    <div class="site-container">
      <div class="grid gap-14 lg:grid-cols-[1fr_1fr] lg:items-center lg:gap-20">
        <div class="image-frame aspect-[4/3]"><img src="/images/winter.webp" alt="冬の草千里から望む阿蘇中岳" class="h-full w-full object-cover" loading="lazy" width="1400" height="900" /></div>
        <div>
          <SectionHeading eyebrow="BY CAR" title="車では、山の条件を優先する。" description="熊本市中心部からは約100分が一つの目安です。カーナビが通行止め区間へ案内する場合があるため、現地標識と係員の指示を優先してください。" />
          <dl class="mt-8 grid gap-5 text-sm">
            <div class="grid grid-cols-[6rem_1fr] border-t hairline pt-4"><dt class="font-bold">所在地</dt><dd class="text-ink-soft">{SITE.address}</dd></div>
            <div class="grid grid-cols-[6rem_1fr] border-t hairline pt-4"><dt class="font-bold">座標</dt><dd class="text-ink-soft">{SITE.coordinates.latitude}, {SITE.coordinates.longitude}</dd></div>
            <div class="grid grid-cols-[6rem_1fr] border-t hairline pt-4"><dt class="font-bold">冬季</dt><dd class="text-ink-soft">積雪・凍結あり。冬用タイヤやチェーンが必要になる場合があります。</dd></div>
            <div class="grid grid-cols-[6rem_1fr] border-t hairline pt-4"><dt class="font-bold">濃霧</dt><dd class="text-ink-soft">急に視界が悪化します。無理に進まず、安全な場所で判断してください。</dd></div>
          </dl>
        </div>
      </div>

      <div class="mt-14 border-t hairline pt-10 md:mt-16 md:pt-12">
        <SectionHeading eyebrow="LOCATION MAP" title="阿蘇山上広場の位置" description="出発前に場所と周辺道路を地図で確認してください。通行規制がある場合は、地図の経路より現地標識と係員の案内を優先してください。" />
        <div class="mt-8 overflow-hidden border hairline bg-paper">
          <iframe
            src={MAP_EMBED_URL}
            width="600"
            height="450"
            class="h-[360px] w-full md:h-[520px]"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            title="阿蘇山上広場のGoogleマップ"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="site-container">
      <SectionHeading eyebrow="PARKING" title="駐車場は、区画と現地表示を確認。" description="阿蘇山上広場と草千里では共通駐車券が案内され、普通車500円が目安となることがあります。一方、ターミナル周辺には案内の異なる区画もあるため、入口の料金表示を優先してください。" />
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {[
          ['阿蘇山上広場', '火口方面の手前にある集散エリア。規制時は進入できる範囲が変わります。'],
          ['阿蘇山上ターミナル', 'バス乗降、休憩、買い物に便利。駐車区画の表示を確認してください。'],
          ['草千里', '博物館・飲食施設に近く、繁忙期は混雑しやすい駐車場です。'],
        ].map(([title, text], i) => (
          <article class="border-t-2 border-moss p-1 pt-6">
            <p class="font-serif text-sm text-earth">0{i + 1}</p><h3 class="mt-4 text-xl">{title}</h3><p class="mt-3 text-sm leading-7 text-ink-soft">{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y hairline bg-white/45 py-16 md:py-24">
    <div class="site-container">
      <SectionHeading eyebrow="ROUTE OVERVIEW" title="移動の全体像" />
      <RouteDiagram />
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/status/" class="button-primary">当日の運行・規制を確認 <Icon name="arrow" size={17} /></a>
        <a href="/plan/" class="button-secondary">旅の組み立て方</a>
      </div>
    </div>
  </section>
</BaseLayout>
