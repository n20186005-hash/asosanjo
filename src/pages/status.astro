---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { MOUNTAIN_STATUS, OFFICIAL_LINKS } from '../config/status';
const levelClasses = { open: 'status-open', limited: 'status-limited', closed: 'status-closed', check: 'status-check' };
---
<BaseLayout title="山の状況｜火口規制・阿蘇山公園道路・バス運行" description="阿蘇山上広場へ出発する前に確認したい、中岳火口の規制、阿蘇山公園道路、山上広場へ向かう道路、火口シャトル、阿蘇登山線の案内です。">
  <PageHero eyebrow="MOUNTAIN STATUS" title="山の状況" description="火山は状況が変わる場所です。火口・道路・バスは別々の状況です。このページの案内だけでなく、出発直前と現地到着時にも公式情報と係員の案内を確認してください。" />

  <section class="py-16 md:py-24">
    <div class="site-container">
      <div class="border-l-4 border-alert bg-alert-soft p-6 md:p-9">
        <div class="flex gap-4">
          <span class="mt-1 text-alert"><Icon name="alert" size={28} /></span>
          <div>
            <p class="text-xs font-bold tracking-[0.16em] text-alert">IMPORTANT NOTICE</p>
            <h2 class="mt-3 font-sans text-xl font-bold text-alert md:text-2xl">{MOUNTAIN_STATUS.alert.title}</h2>
            <p class="mt-4 max-w-4xl text-sm leading-8 text-ink-soft">{MOUNTAIN_STATUS.alert.body}</p>
          </div>
        </div>
      </div>

      <div class="mt-12 grid gap-px bg-ink/15 md:grid-cols-2 lg:grid-cols-3">
        {MOUNTAIN_STATUS.items.map((item) => (
          <article class="bg-paper p-7 md:p-9">
            <div class="flex items-center gap-3">
              <span class:list={['status-dot', levelClasses[item.level]]}></span>
              <p class="text-xs font-bold tracking-[0.14em] text-ink-soft">{item.label}</p>
            </div>
            <p class="mt-5 font-serif text-3xl tracking-[0.06em]">{item.value}</p>
            <p class="mt-4 text-sm leading-7 text-ink-soft">{item.note}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-y hairline bg-paper-deep/55 py-16 md:py-24">
    <div class="site-container grid gap-12 lg:grid-cols-[.8fr_1.2fr] lg:gap-20">
      <SectionHeading eyebrow="HOW TO READ" title="四つを別々に確認する。" description="火口が閉鎖されていても、草千里や山上ターミナルまで行ける場合があります。反対に、路線バスや道路が止まれば、山上広場そのものへ到達できないことがあります。" />
      <ol class="grid gap-6">
        {[
          ['01', '火口規制', '中岳第一火口の見学可否。噴火警戒、火山ガス、風向きで変わります。'],
          ['02', '道路状況', '阿蘇山公園道路だけでなく、山上へ向かう県道の通行可否も確認します。'],
          ['03', '路線バス', '阿蘇駅からの阿蘇登山線。往路と復路、特に最終便を確認します。'],
          ['04', '山上の天候', '平地と異なり、濃霧、強風、雪、凍結で視界と移動条件が変わります。'],
        ].map(([num, title, text]) => (
          <li class="grid grid-cols-[3.5rem_1fr] gap-4 border-t hairline pt-5">
            <span class="font-serif text-xl text-earth">{num}</span>
            <div><h3 class="font-sans text-base font-bold">{title}</h3><p class="mt-2 text-sm leading-7 text-ink-soft">{text}</p></div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="site-container-narrow">
      <SectionHeading eyebrow="OFFICIAL INFORMATION" title="最終判断は、公式案内と現地表示で。" description={MOUNTAIN_STATUS.sourceNote} />
      <div class="mt-9 grid gap-3 sm:grid-cols-2">
        <a href={OFFICIAL_LINKS.volcano} target="_blank" rel="noopener noreferrer" class="button-secondary justify-between">阿蘇火山火口規制情報（公式） <Icon name="external" size={16} /></a>
        <a href={OFFICIAL_LINKS.crater} target="_blank" rel="noopener noreferrer" class="button-secondary justify-between">阿蘇市｜公園道路・火口規制 <Icon name="external" size={16} /></a>
        <a href={OFFICIAL_LINKS.bus} target="_blank" rel="noopener noreferrer" class="button-secondary justify-between">産交バス｜阿蘇登山線 <Icon name="external" size={16} /></a>
        <a href={OFFICIAL_LINKS.busTimetable} target="_blank" rel="noopener noreferrer" class="button-secondary justify-between">産交バス｜時刻表 <Icon name="external" size={16} /></a>
      </div>
      <p class="mt-5 text-xs leading-6 text-ink-soft">外部サイトは最新情報の確認に必要な公式ページのみ掲載しています。このページは自動でリアルタイム情報を取得していません。</p>
    </div>
  </section>
</BaseLayout>
